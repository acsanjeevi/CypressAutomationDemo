{
  "name": "cypress-automation-demo",
  "version": "1.0.0",
  "description": "OrangeHRM Cypress Automation with TypeScript",
  "main": "index.js",
  "scripts": {
    "test": "cypress run --spec 'cypress/e2e/login.cy.ts,cypress/e2e/employee.cy.ts,cypress/e2e/user.cy.ts,cypress/e2e/leave.cy.ts,cypress/e2e/claim.cy.ts,cypress/e2e/cleanup.cy.ts' --browser chrome",
    "test:chrome": "cypress run --browser chrome",
    "test:firefox": "cypress run --browser firefox",
    "test:edge": "cypress run --browser edge",
    "test:headless": "cypress run --headless --browser chrome",
    "test:headed": "node runTestsHeadedSequential.js",
    "test:cleanup": "cypress run --spec 'cypress/e2e/cleanup.cy.ts' --browser chrome",
    "test:all:cleanup": "npm run test && npm run report:all",
    "report:merge": "node scripts/merge-reports.js --check-reports",
    "report:generate": "npx mochawesome-report-generator 'cypress/reports/mochawesome-report/unified-report.json' -o 'cypress/reports/mochawesome-report'",
    "report:all": "npm run report:merge && npm run report:generate",
    "test:all:report": "npm run test && npm run report:all",
    "cypress:open": "cypress open"
  },
  "keywords": [
    "cypress",
    "typescript",
    "orangehrm",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.6",
    "cypress": "^13.6.2",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.0",
    "mochawesome-report-generator": "^6.3.2",
    "pptxgenjs": "^4.0.1",
    "typescript": "^5.3.3"
  }
}
